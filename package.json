{
	"name": "@ablehq/apex-cms-kit",
	"version": "0.1.0",
	"description": "The site-side half of the Apex CMS: BFF, admin UI, content publish/read, for SvelteKit sites on Cloudflare Workers.",
	"license": "MIT",
	"type": "module",
	"repository": "github:ablehq/apex-cms-kit",
	"svelte": "./src/index.js",
	"exports": {
		".": {
			"svelte": "./src/index.js",
			"default": "./src/index.js"
		},
		"./*.svelte": "./src/*.svelte",
		"./*.js": "./src/*.js",
		"./*.ts": "./src/*.ts",
		"./*.css": "./src/*.css",
		"./migrations/*": "./migrations/*",
		"./*": "./src/*.ts"
	},
	"files": [
		"src",
		"migrations"
	],
	"scripts": {
		"test": "node --import tsx --test tests/*.test.js",
		"check": "tsc --noEmit -p tsconfig.json",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.20.0",
		"svelte": "^5.0.0",
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@sveltejs/kit": "2.55.0",
		"@types/node": "^22",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"svelte": "5.53.12",
		"tsx": "^4.21.0",
		"typescript": "5.9.3",
		"zod": "4.4.3",
		"vite": "7.3.1"
	},
	"engines": {
		"node": "22.23.2"
	}
}
